# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Supplier Service ---------
SUPPLIER_SERVICE_PORT=3002
# Used by Docker Compose to create the supplier database. Keep them in step with the two URLs below.
SUPPLIER_DB_USER=supplier
SUPPLIER_DB_PASSWORD=change-me
SUPPLIER_DB_NAME=supplier
SUPPLIER_DB_PORT=5433
# Used when the service runs on your machine instead of in Compose.
SUPPLIER_DATABASE_URL=postgres://supplier:change-me@localhost:5433/supplier
# Only for the tests. The database name must end in _test because the tests empty it.
SUPPLIER_TEST_DATABASE_URL=postgres://supplier:change-me@localhost:5433/supplier_test
SUPPLIER_TIMEZONE=Asia/Singapore
SUPPLIER_SEED_ON_STARTUP=true
SUPPLIER_SEED_CSV_PATH=../data/csv/supplier-seed-data.csv
# Seconds a read is served from memory. A session may read for AUTH seconds after it is suspended,
# and a change made by another instance takes up to READ seconds to show. 0 turns a cache off.
SUPPLIER_AUTH_CACHE_SECONDS=5
SUPPLIER_READ_CACHE_SECONDS=2

# ---- Read by any service that calls the User Service ----
USER_SERVICE_URL=http://localhost:3001

# ... Add more variables as needed
