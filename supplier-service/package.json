{
  "name": "supplier-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "dev:fake-user-service": "node --env-file-if-exists=../.env dev/fake-user-service.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../.env --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.2"
  }
}
